# Public build configuration only. Never place secrets in VITE_* variables.
VITE_ANALYTICS_ENABLED=false
VITE_PLAUSIBLE_DOMAIN=kelmetrik.com
# Optional override; the owner-confirmed default is Kelmetrik.
VITE_PRIVACY_RESPONSIBLE=Kelmetrik
# Optional URL-prefix Search Console verification token (public, not a secret).
VITE_GOOGLE_SITE_VERIFICATION=
